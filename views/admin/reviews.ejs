
<% layout("layouts/boilerplate") %>

<div class="admin-wrapper">

    <%- include("partials/sidebar", { activePage: "reviews" }) %>

    <main class="admin-main">

        <%- include("partials/topbar", {
            pageTitle: "Manage Reviews",
            pageSubtitle: "Monitor customer feedback and manage submitted reviews."
        }) %>


        <!-- Review Summary -->
        <section class="listing-summary">

            <div class="listing-summary-icon">
                <i class="fa-solid fa-star"></i>
            </div>

            <div>
                <p>Total Customer Reviews</p>
                <h2><%= reviews.length %></h2>
            </div>

            <span class="listing-summary-label">
                ALL REVIEWS
            </span>

        </section>


        <!-- Reviews Table -->
        <section class="admin-panel-card">

            <div class="section-heading">

                <div>
                    <p class="section-eyebrow">CUSTOMER FEEDBACK</p>
                    <h2>All Reviews</h2>
                    <p>Review customer feedback and manage inappropriate content.</p>
                </div>

                <div class="section-heading-icon">
                    <i class="fa-solid fa-comments"></i>
                </div>

            </div>


            <div class="admin-table-wrapper">

                <table class="admin-table">

                    <thead>
                        <tr>
                            <th>REVIEW</th>
                            <th>RATING</th>
                            <th>AUTHOR</th>
                            <th>LISTING</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>


                    <tbody>

                        <% if (reviews.length === 0) { %>

                            <tr>
                                <td colspan="5" class="empty-state">

                                    <div class="empty-state-content">
                                        <i class="fa-regular fa-comment-dots"></i>
                                        <h3>No Reviews Found</h3>
                                        <p>There are currently no customer reviews.</p>
                                    </div>

                                </td>
                            </tr>

                        <% } else { %>

                            <% reviews.forEach(review => { %>

                                <% const listing = listingMap[review._id.toString()]; %>

                                <tr>

                                    <!-- Review Comment -->
                                    <td data-label="Review">

                                        <div class="review-comment">

                                            <i class="fa-solid fa-quote-left"></i>

                                            <span>
                                                <%= review.comment || "No comment provided." %>
                                            </span>

                                        </div>

                                    </td>


                                    <!-- Rating -->
                                    <td data-label="Rating">

                                        <span class="rating">
                                            <i class="fa-solid fa-star"></i>
                                            <%= review.rating %>/5
                                        </span>

                                    </td>


                                    <!-- Author -->
                                    <td data-label="Author">

                                        <div class="owner-info">

                                            <div class="owner-avatar">
                                                <%= review.author?.username?.charAt(0).toUpperCase() || "U" %>
                                            </div>

                                            <span>
                                                <%= review.author?.username || "Unknown" %>
                                            </span>

                                        </div>

                                    </td>


                                    <!-- Listing -->
                                    <td data-label="Listing">

                                        <% if (listing) { %>

                                            <a
                                                href="/listings/<%= listing._id %>"
                                                class="review-listing-link"
                                            >
                                                <i class="fa-solid fa-house"></i>
                                                <%= listing.title %>
                                            </a>

                                        <% } else { %>

                                            <span class="unknown-listing">
                                                Listing unavailable
                                            </span>

                                        <% } %>

                                    </td>


                                    <!-- Actions -->
                                    <td data-label="Actions">

                                        <form
                                            action="/admin/reviews/<%= review._id %>?_method=DELETE"
                                            method="POST"
                                            onsubmit="return confirm('Are you sure you want to delete this review? This action cannot be undone.');"
                                        >

                                            <button
                                                type="submit"
                                                class="delete-btn"
                                            >
                                                <i class="fa-regular fa-trash-can"></i>
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>

                            <% }) %>

                        <% } %>

                    </tbody>

                </table>

            </div>

        </section>


        <%- include("partials/footer") %>

    </main>

</div>
