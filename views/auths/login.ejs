
<% layout('layouts/boilerplate') -%>

<div class="container">
  <div class="row justify-content-center align-items-center min-vh-75 py-4 py-md-5">
    <div class="col-12 col-sm-10 col-md-6 col-lg-4">

      <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-body p-3 p-sm-4 p-md-5 mx-1 mx-md-3 bg-white">

          <!-- Heading & Subtitle -->
          <div class="text-center mb-4">
            <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                 style="width: 55px; height: 55px;">
              <i class="fa-solid fa-lock fs-4"></i>
            </div>

            <h2 class="fw-bold text-dark">Welcome Back</h2>
            <p class="text-muted small mb-0">
              Please enter your details to sign in
            </p>
          </div>

          <!-- Form -->
          <form action="/auth/login" method="POST" class="needs-validation" novalidate>

            <div class="mb-3">
              <label for="email" class="form-label fw-semibold text-secondary small">
                Username
              </label>

              <div class="input-group">
                <input
                  type="text"
                  class="form-control rounded-3 py-2 px-3 shadow-none border-secondary-subtle"
                  id="email"
                  name="email"
                  placeholder="Username"
                  autocomplete="username"
                  required
                >
              </div>
            </div>

            <div class="mb-4">
              <label for="password" class="form-label fw-semibold text-secondary small">
                Password
              </label>

              <div class="input-group">
                <input
                  type="password"
                  class="form-control rounded-3 py-2 px-3 shadow-none border-secondary-subtle"
                  id="password"
                  name="password"
                  placeholder="••••••••"
                  autocomplete="current-password"
                  required
                >
              </div>
            </div>

            <!-- Sign In Button -->
            <button type="submit"
                    class="btn btn-danger w-100 py-2 fw-semibold rounded-3 shadow-sm transition-all">
              Sign In
            </button>

          </form>

          <!-- Footer Link -->
          <div class="text-center mt-4 pt-3 border-top border-light">
            <p class="text-muted small mb-0">
              Don't have an account?
              <a href="/auth/register" class="text-danger text-decoration-none fw-semibold">
                Register here
              </a>
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
