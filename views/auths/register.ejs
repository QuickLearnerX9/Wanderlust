
<% layout('layouts/boilerplate') -%>

<div class="container">
  <div class="row justify-content-center align-items-center min-vh-75 py-4 py-md-5">

    <div class="col-12 col-sm-10 col-md-7 col-lg-5">

      <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
        <div class="card-body p-3 p-sm-4 p-md-5 mx-1 mx-md-3 bg-white">

          <!-- Heading & Subtitle -->
          <div class="text-center mb-4">
            <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                 style="width: 55px; height: 55px;">
              <i class="fa-solid fa-user-plus fs-4"></i>
            </div>

            <h2 class="fw-bold text-dark">Create Account</h2>
            <p class="text-muted small mb-0">
              Sign up to get started with your journey
            </p>
          </div>

          <!-- Registration Form -->
          <form action="/auth/register" method="POST" class="needs-validation" novalidate>

            <div class="mb-3 mb-md-4">
              <label for="username" class="form-label fw-semibold text-secondary small">
                Username
              </label>

              <input
                type="text"
                class="form-control rounded-3 py-2 px-3 shadow-none border-secondary-subtle"
                id="username"
                name="username"
                placeholder="johndoe"
                autocomplete="username"
                required
              >
            </div>

            <div class="mb-3 mb-md-4">
              <label for="email" class="form-label fw-semibold text-secondary small">
                Email address
              </label>

              <input
                type="email"
                class="form-control rounded-3 py-2 px-3 shadow-none border-secondary-subtle"
                id="email"
                name="email"
                placeholder="name@example.com"
                autocomplete="email"
                required
              >
            </div>

            <div class="mb-3 mb-md-4">
              <label for="password" class="form-label fw-semibold text-secondary small">
                Password
              </label>

              <input
                type="password"
                class="form-control rounded-3 py-2 px-3 shadow-none border-secondary-subtle"
                id="password"
                name="password"
                placeholder="••••••••"
                autocomplete="new-password"
                required
              >
            </div>

            <button type="submit"
                    class="btn btn-danger w-100 py-2 fw-semibold rounded-3 shadow-sm transition-all mt-2">
              Register
            </button>

          </form>

          <!-- Footer Link -->
          <div class="text-center mt-4 pt-3 border-top border-light">
            <p class="text-muted small mb-0">
              Already have an account?
              <a href="/auth/login" class="text-danger text-decoration-none fw-semibold">
                Login here
              </a>
            </p>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
