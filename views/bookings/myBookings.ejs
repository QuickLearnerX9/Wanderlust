<% layout('layouts/boilerplate') -%>
<div class="booking-page-wrap">
    <div class="booking-page-heading">
        <div>
            <p class="booking-eyebrow">YOUR WANDERLUST JOURNEY</p>
            <h1>My trips</h1>
            <p class="text-muted mb-0">Keep track of your stay requests and reservations.</p>
        </div>
        <a href="/listings" class="btn btn-outline-dark rounded-pill px-4"><i class="fa-solid fa-compass me-2"></i>Explore stays</a>
    </div>

    <% if (bookings.length) { %>
        <div class="booking-list-grid">
            <% bookings.forEach(booking => { %>
                <article class="booking-list-card">
                    <a class="booking-list-image" href="/bookings/<%= booking._id %>">
                        <img src="<%= booking.listing ? booking.listing.image.url : '' %>" alt="<%= booking.listing ? booking.listing.title : 'Property' %>">
                    </a>
                    <div class="booking-list-content">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <p class="booking-eyebrow mb-1">YOUR RESERVATION</p>
                                <h2><%= booking.listing ? booking.listing.title : 'Listing unavailable' %></h2>
                                <p class="text-muted small mb-2"><i class="fa-solid fa-location-dot me-1"></i><%= booking.listing ? `${booking.listing.location}, ${booking.listing.country}` : '' %></p>
                            </div>
                            <span class="status-pill status-<%= booking.status %>"><%= booking.status %></span>
                        </div>
                        <div class="booking-list-meta">
                            <span><i class="fa-regular fa-calendar me-2"></i><%= booking.checkIn.toLocaleDateString('en-IN') %> – <%= booking.checkOut.toLocaleDateString('en-IN') %></span>
                            <span><i class="fa-solid fa-moon me-2"></i><%= booking.nights %> nights</span>
                            <span><i class="fa-solid fa-users me-2"></i><%= booking.guests %> guests</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3">
                            <div><span class="text-muted small">Total</span><div class="fw-bold fs-5">&#8377;<%= Number(booking.totalPrice).toLocaleString('en-IN') %></div></div>
                            <a href="/bookings/<%= booking._id %>" class="btn btn-dark rounded-pill px-4">View details</a>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>
    <% } else { %>
        <div class="booking-empty-state">
            <div class="empty-icon"><i class="fa-regular fa-calendar-xmark"></i></div>
            <h2>No trips booked yet</h2>
            <p class="text-muted">When you request a stay, it will appear here.</p>
            <a href="/listings" class="btn btn-danger rounded-pill px-4">Find a place to stay</a>
        </div>
    <% } %>
</div>
