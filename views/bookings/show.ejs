<% layout('layouts/boilerplate') -%>
<div class="booking-detail-wrap">
    <a href="<%= isHost ? '/bookings/host' : '/bookings/my' %>" class="booking-back-link"><i class="fa-solid fa-arrow-left me-2"></i>Back to <%= isHost ? 'host reservations' : 'my trips' %></a>
    <div class="booking-detail-heading">
        <div><p class="booking-eyebrow">RESERVATION DETAILS</p><h1>Your booking</h1><p class="text-muted mb-0">Booking reference <span class="font-monospace">#<%= booking._id.toString().slice(-8).toUpperCase() %></span></p></div>
        <span class="status-pill status-<%= booking.status %>"><%= booking.status %></span>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <section class="booking-detail-card">
                <img class="booking-detail-cover" src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>">
                <div class="p-4">
                    <h2><%= booking.listing.title %></h2>
                    <p class="text-muted"><i class="fa-solid fa-location-dot text-danger me-2"></i><%= booking.listing.location %>, <%= booking.listing.country %></p>
                    <div class="detail-facts">
                        <div><small>CHECK-IN</small><strong><%= booking.checkIn.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %></strong></div>
                        <div><small>CHECK-OUT</small><strong><%= booking.checkOut.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) %></strong></div>
                        <div><small>DURATION</small><strong><%= booking.nights %> nights</strong></div>
                        <div><small>GUESTS</small><strong><%= booking.guests %></strong></div>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between"><span class="text-muted">&#8377;<%= Number(booking.pricePerNight).toLocaleString('en-IN') %> × <%= booking.nights %> nights</span><strong>&#8377;<%= Number(booking.totalPrice).toLocaleString('en-IN') %></strong></div>
                    <div class="d-flex justify-content-between fs-5 fw-bold mt-3"><span>Total (no payment collected)</span><span>&#8377;<%= Number(booking.totalPrice).toLocaleString('en-IN') %></span></div>
                </div>
            </section>
        </div>
        <div class="col-lg-5">
            <section class="booking-detail-card p-4 mb-4">
                <h3 class="h5 fw-bold mb-3"><%= isHost ? 'Guest information' : 'Your host' %></h3>
                <div class="person-row"><div class="person-avatar"><i class="fa-solid fa-user"></i></div><div><strong><%= isHost ? booking.user.username : booking.host.username %></strong><small><%= isHost ? booking.user.email : booking.host.email %></small></div></div>
                <hr>
                <h3 class="h6 fw-bold">Booking timeline</h3>
                <p class="small text-muted mb-1">Requested on <%= booking.createdAt.toLocaleDateString('en-IN') %></p>
                <% if (booking.status === 'pending') { %><p class="small mb-0">Waiting for the host to review this request.</p><% } else if (booking.status === 'confirmed') { %><p class="small text-success mb-0">Your reservation is confirmed.</p><% } else if (booking.status === 'rejected') { %><p class="small text-danger mb-0">The host declined this request.</p><% } else { %><p class="small text-muted mb-0">This reservation has been cancelled.</p><% } %>
            </section>

            <% if (isHost && booking.status === 'pending') { %>
                <section class="booking-action-card">
                    <h3 class="h5 fw-bold">Respond to request</h3>
                    <p class="small text-muted">Confirm only if the dates are available for this property.</p>
                    <form action="/bookings/<%= booking._id %>/confirm?_method=PATCH" method="POST" class="mb-2" data-confirm="Confirm this booking request?">
                        <button class="btn btn-danger w-100 rounded-pill py-2" type="submit"><i class="fa-solid fa-check me-2"></i>Confirm booking</button>
                    </form>
                    <form action="/bookings/<%= booking._id %>/reject?_method=PATCH" method="POST" data-confirm="Reject this booking request?">
                        <button class="btn btn-outline-danger w-100 rounded-pill py-2" type="submit">Decline request</button>
                    </form>
                </section>
            <% } %>

            <% if ((isGuest || isHost) && ['pending', 'confirmed'].includes(booking.status)) { %>
                <form action="/bookings/<%= booking._id %>/cancel?_method=PATCH" method="POST" data-confirm="Are you sure you want to cancel this booking?" class="mt-3">
                    <button class="btn btn-outline-secondary w-100 rounded-pill py-2" type="submit">Cancel reservation</button>
                </form>
            <% } %>
        </div>
    </div>
</div>
