      <div class="w-100 text-center py-3">
        <h1 class="display-4 fw-bold text-danger mb-2"><%= statusCode %></h1>
        <p class="fs-5 text-dark mb-4"><%= message %></p>
        <a href="/listings" class="btn btn-outline-danger me-2">Back to Listings</a>
        <a href="/" class="btn btn-danger">Go Home</a>
      </div>
    </div>
  </div>
</div>