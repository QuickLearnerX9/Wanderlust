<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top py-2">
  <div class="container-fluid px-md-4">
    <!-- Brand / Logo -->
    <a class="navbar-brand d-flex align-items-center gap-2 me-3" href="/">
      <i class="fa-regular fa-compass logo-icon"></i>
      <span class="fw-bold brand-text">wanderlust</span>
    </a>

    <!-- Mobile Toggler -->
    <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <!-- Left Navigation: Explore Link -->
      <div class="navbar-nav me-auto">
        <a class="nav-link explore-link fw-semibold px-3 py-2 rounded-pill d-flex align-items-center gap-1" href="/listings">
          <i class="fa-solid fa-compass text-danger"></i>
          <span>Explore</span>
        </a>
      </div>

      <!-- Center: Airbnb-style Floating Search Capsule -->
      <div class="mx-auto my-2 my-md-0">
        <form class="d-flex align-items-center search-form m-0" role="search" action="/listings" method="GET">
          <div class="search-capsule d-flex align-items-center">
            <input 
              class="form-control search-input" 
              type="search" 
              name="q" 
              placeholder="Search destinations, cities, countries..." 
              value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
              autocomplete="off"
            >
            <button class="btn btn-search-circle" type="submit" title="Search">
              <i class="fa-solid fa-magnifying-glass"></i>
            </button>
          </div>
        </form>
      </div>

      <!-- Right Navigation: Host / Create Listing & Auth -->
      <div class="navbar-nav ms-auto align-items-center gap-2">
        <!-- Host Link: Create List: Your Own Airbnb -->
        <a class="nav-link host-link fw-semibold px-3 py-2 rounded-pill d-flex align-items-center gap-1" href="/listings/new" title="Host your place on Wanderlust">
          <i class="fa-solid fa-house-chimney-medical text-danger"></i>
          <span>Add Your Own Hotel</span>
        </a>

        <% if (!currUser) { %>
          <div class="d-flex align-items-center gap-2">
            <a class="btn btn-auth-outline px-3 py-1 rounded-pill fw-semibold" href="/auth/register">Sign up</a>
            <a class="btn btn-auth-solid px-3 py-1 rounded-pill fw-semibold" href="/auth/login">Log in</a>
          </div>
        <% } else { %>
          <div class="dropdown">
            <button class="btn btn-user-menu rounded-pill px-3 py-1 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-bars text-secondary me-1"></i>
              <i class="fa-solid fa-circle-user text-danger fs-5"></i>
              <span class="fw-semibold text-dark small"><%= currUser.username %></span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2 p-2">
              <li>
                <div class="px-3 py-2 border-bottom mb-1">
                  <div class="fw-bold small text-dark"><%= currUser.username %></div>
                  <div class="text-muted small"><%= currUser.email %></div>
                </div>
              </li>
     
              <li><hr class="dropdown-divider my-1"></li>
              <li><a class="dropdown-item py-2 rounded-3" href="/bookings/my"><i class="fa-solid fa-suitcase-rolling me-2 text-danger"></i>My trips</a></li>
              <li><a class="dropdown-item py-2 rounded-3" href="/bookings/host"><i class="fa-solid fa-house-user me-2 text-danger"></i>Host reservations</a></li>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <a class="dropdown-item py-2 rounded-3 text-danger d-flex align-items-center gap-2" href="/auth/logout">
                  <i class="fa-solid fa-right-from-bracket"></i>
                  <span>Log out</span>
                </a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
