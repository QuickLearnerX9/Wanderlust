<% layout('layouts/boilerplate') -%>

<!-- Hero Section -->
<div class="hero-banner rounded-4 p-4 p-md-5 my-4 position-relative overflow-hidden shadow-sm">
    <div class="hero-bg-overlay"></div>
    <div class="position-relative z-1 py-md-3">
        <span class="badge bg-danger bg-opacity-90 rounded-pill px-3 py-2 text-uppercase letter-spacing-1 mb-3">
            <i class="fa-solid fa-house-chimney-medical me-1"></i> Host & Explore: Your Own Airbnb
        </span>
        <h1 class="display-5 fw-bold text-white mb-3">Find your next unforgettable getaway</h1>
        <p class="lead text-white-50 mb-4" style="max-width: 620px;">
            Discover handpicked beachfront cottages, peaceful mountain retreats, and vibrant city lofts — or host your place to welcome travelers from around the world.
        </p>
        <div class="d-flex flex-wrap gap-3">
            <a href="/listings" class="btn btn-danger btn-lg px-4 py-2 rounded-pill fw-bold shadow-sm d-flex align-items-center gap-2">
                <i class="fa-solid fa-compass"></i>
                <span>Explore All Stays</span>
            </a>
            <a href="/listings/new" class="btn btn-outline-light btn-lg px-4 py-2 rounded-pill fw-bold d-flex align-items-center gap-2">
                <i class="fa-solid fa-plus"></i>
                <span>Airbnb your home</span>
            </a>
        </div>
    </div>
</div>

<!-- Section Header -->
<div class="d-flex align-items-center justify-content-between mb-3 mt-4">
    <div>
        <h3 class="fw-bold mb-1">Explore by Category</h3>
        <p class="text-muted small mb-0">Browse through trending destinations and curated styles</p>
    </div>
</div>

<!-- Category Filters Bar -->
<div id="filters">
    <a href="/" class="filter">
        <div><i class="fa-solid fa-globe"></i></div>
        <p>All</p>
    </a>
    <a href="/listings?category=Trending" class="filter">
        <div><i class="fa-solid fa-fire"></i></div>
        <p>Trending</p>
    </a>
    <a href="/listings?category=Rooms" class="filter">
        <div><i class="fa-solid fa-bed"></i></div>
        <p>Rooms</p>
    </a>
    <a href="/listings?category=Iconic Cities" class="filter">
        <div><i class="fa-solid fa-mountain-city"></i></div>
        <p>Iconic Cities</p>
    </a>
    <a href="/listings?category=Mountains" class="filter">
        <div><i class="fa-solid fa-mountain"></i></div>
        <p>Mountains</p>
    </a>
    <a href="/listings?category=Castles" class="filter">
        <div><i class="fa-solid fa-chess-rook"></i></div>
        <p>Castles</p>
    </a>
    <a href="/listings?category=Amazing Pools" class="filter">
        <div><i class="fa-solid fa-person-swimming"></i></div>
        <p>Amazing Pools</p>
    </a>
    <a href="/listings?category=Camping" class="filter">
        <div><i class="fa-solid fa-campground"></i></div>
        <p>Camping</p>
    </a>
    <a href="/listings?category=Farms" class="filter">
        <div><i class="fa-solid fa-cow"></i></div>
        <p>Farms</p>
    </a>
    <a href="/listings?category=Arctic" class="filter">
        <div><i class="fa-solid fa-snowflake"></i></div>
        <p>Arctic</p>
    </a>
    <a href="/listings?category=Domes" class="filter">
        <div><i class="fa-solid fa-igloo"></i></div>
        <p>Domes</p>
    </a>
    <a href="/listings?category=Boats" class="filter">
        <div><i class="fa-solid fa-ship"></i></div>
        <p>Boats</p>
    </a>

    <!-- Tax Toggle Switch -->
    <div class="tax-toggle">
        <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault">
            <label class="form-check-label" for="flexSwitchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>

<!-- Featured Listings Section -->
<div class="d-flex align-items-center justify-content-between mb-3 mt-4">
    <h4 class="fw-bold m-0">Featured Stays</h4>
    <a href="/listings" class="text-danger fw-semibold text-decoration-none d-flex align-items-center gap-1">
        <span>View all</span>
        <i class="fa-solid fa-arrow-right small"></i>
    </a>
</div>

<!-- Listings Grid -->
<div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 mb-5">
    <% for(let listing of allListings) { %>
        <%
            let avgRating = 0;
            if (listing.reviews && listing.reviews.length > 0) {
                let validRatings = listing.reviews
                    .filter(r => r && typeof r.rating === 'number')
                    .map(r => r.rating);
                if (validRatings.length > 0) {
                    let sum = validRatings.reduce((acc, curr) => acc + curr, 0);
                    avgRating = parseFloat((sum / validRatings.length).toFixed(1));
                }
            } else if (typeof listing.avgRating === 'number') {
                avgRating = listing.avgRating;
            }
        %>
        <div class="col">
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card listing-card h-100">
                    <div class="card-img-wrapper position-relative">
                        <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>">
                        <!-- Category Badge Overlay -->
                        <span class="badge position-absolute top-0 start-0 m-3 px-3 py-1 rounded-pill category-badge shadow-sm">
                            <%= listing.category || 'Featured' %>
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                            <h6 class="card-title fw-bold text-truncate m-0" style="max-width: 80%;"><%= listing.title %></h6>
                            <span class="text-muted small">
                                <i class="fa-solid fa-star text-warning"></i> <%= avgRating %>
                            </span>
                        </div>
                        <p class="text-muted small mb-1">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i><%= listing.location %>, <%= listing.country %>
                        </p>
                        <p class="card-text text-dark m-0">
                            <strong>&#8377; <%= Number(listing.price).toLocaleString("en-IN") %></strong>
                            <span class="text-muted fw-normal">/ night</span>
                            <i class="tax-info text-danger small">&nbsp; &nbsp;+18% GST</i>
                        </p>
                    </div>
                </div>
            </a>
        </div>
    <% } %>
</div>

<!-- Bottom Explore CTA -->
<div class="explore-cta-box rounded-4 p-4 p-md-5 my-5 text-center bg-light border">
    <h3 class="fw-bold mb-2">Want to see more amazing places?</h3>
    <p class="text-muted mb-4" style="max-width: 500px; margin: 0 auto;">Browse through our entire collection of unique spaces around the globe.</p>
    <a href="/listings" class="btn btn-danger btn-lg px-5 py-2 rounded-pill fw-bold shadow-sm">
        <i class="fa-solid fa-compass me-2"></i>Explore More
    </a>
</div>
